# ---- Required ----
# Postgres. On Fly, `fly postgres attach` sets this for you; locally point at your own database.
DATABASE_URL=postgres://emmajane:emmajane@127.0.0.1:5432/emmajane

# Signs session and gallery cookies. At least 32 random characters:  openssl rand -hex 32
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Emma's Studio password — used ONCE, on first boot, to create the admin account (10+ characters).
ADMIN_PASSWORD=
ADMIN_EMAIL=hello@emmajanephoto.com

# ---- Object storage (photos must outlive the machine) ----
# `fly storage create` (Tigris) sets all five of these automatically. Cloudflare R2 / Backblaze B2
# use the same names. Leave BUCKET_NAME empty locally to write into ./.storage instead.
BUCKET_NAME=
AWS_ENDPOINT_URL_S3=
AWS_REGION=auto
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ---- Optional ----
SITE_URL=http://localhost:3000
# Email notifications (new inquiry, first gallery open) through Resend. Off until both are set.
RESEND_API_KEY=
NOTIFY_EMAIL=
FROM_EMAIL=Emma Jane Photography <no-reply@emmajanephoto.com>
